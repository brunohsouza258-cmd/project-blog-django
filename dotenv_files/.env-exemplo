SECRET_KEY="CHANGE-ME"

# 0 False, 1 True
DEBUG="1"

# Comma Separated values
ALLOWED_HOSTS="127.0.0.1, localhost"

DB_ENGINE="django.db.backends.postgresql"
POSTGRES_DB="CHANGE-ME"
POSTGRES_USER="CHANGE-ME"
POSTGRES_PASSWORD="CHANGE-ME"
POSTGRES_HOST="psql"
POSTGRES_PORT="5432"

# E-mail (opcional). Sem EMAIL_HOST os e-mails só aparecem no terminal.
# Gmail: use uma "senha de app" (myaccount.google.com/apppasswords),
# não a senha normal da conta.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""


# IA local (Ollama). Troque o modelo por um menor (qwen2.5:1.5b) se as
# respostas estiverem lentas, ou maior (qwen2.5:7b) se tiver RAM sobrando.
OLLAMA_URL="http://ollama:11434"
OLLAMA_MODEL="qwen2.5:3b"


# Segurança em produção
# Endereço secreto do admin (termine com "/"). Padrão: admin/
ADMIN_URL="admin/"
# Proxies (ex.: nginx) na frente do Django. 0 = acesso direto.
NUM_PROXIES="0"
# Domínio do site, para formulários em HTTPS. Ex.: https://meublog.com
CSRF_TRUSTED_ORIGINS=""
